Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Enabled: true
  Name: root
  Value: true
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 0.8
    Binary representation: false
    Binary threshold: 100
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: false
    Enabled: true
    Name: Shared occupancy map
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Value: /robot1/robot_description
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Enabled: true
    Links:
      All Links Enabled: true
    Mass Properties:
      Inertia: false
      Mass: false
    Name: robot1
    TF Prefix: robot1
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/Polygon
    Name: robot1 footprint
    Enabled: true
    Value: true
    Color: 40; 150; 255
    Alpha: 1.0
    Topic:
      Value: /robot1/local_costmap/published_footprint
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: robot1 AMCL
    Enabled: true
    Value: true
    Color: 40; 150; 255
    Topic:
      Value: /robot1/amcl_pose
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Shape: Arrow
    Shaft Length: 0.2
    Shaft Radius: 0.015
    Head Length: 0.07
    Head Radius: 0.035
  - Class: rviz_default_plugins/Path
    Name: robot1 global path
    Enabled: true
    Value: true
    Color: 40; 150; 255
    Alpha: 1.0
    Line Style: Billboards
    Line Width: 0.025
    Topic:
      Value: /robot1/plan
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 40; 150; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: robot1 LiDAR
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Flat Squares
    Topic:
      Value: /robot1/scan
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Value: /robot2/robot_description
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Enabled: true
    Links:
      All Links Enabled: true
    Mass Properties:
      Inertia: false
      Mass: false
    Name: robot2
    TF Prefix: robot2
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/Polygon
    Name: robot2 footprint
    Enabled: true
    Value: true
    Color: 255; 110; 25
    Alpha: 1.0
    Topic:
      Value: /robot2/local_costmap/published_footprint
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: robot2 AMCL
    Enabled: true
    Value: true
    Color: 255; 110; 25
    Topic:
      Value: /robot2/amcl_pose
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Shape: Arrow
    Shaft Length: 0.2
    Shaft Radius: 0.015
    Head Length: 0.07
    Head Radius: 0.035
  - Class: rviz_default_plugins/Path
    Name: robot2 global path
    Enabled: true
    Value: true
    Color: 255; 110; 25
    Alpha: 1.0
    Line Style: Billboards
    Line Width: 0.025
    Topic:
      Value: /robot2/plan
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 110; 25
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: robot2 LiDAR
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Flat Squares
    Topic:
      Value: /robot2/scan
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Targets, rescue radii and FSM progress
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /rescue/markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PoseArray
    Name: Current rescue goals
    Enabled: true
    Value: true
    Color: 255; 255; 0
    Topic:
      Value: /rescue/goals
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
    Background Color: 48; 48; 48
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 9.5
      Pitch: 1.3
      Yaw: -1.570796326795
      Focal Point:
        X: 2.5
        Y: 2.5
        Z: 0
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Width: 1500
  Height: 900
  X: 20
  Y: 20
  QMainWindow State: 
  Displays:
    collapsed: false
  Views:
    collapsed: false
