<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="empty">

    <!-- Physics -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR / camera sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>

        </visual>

      </link>
    </model>


  <!-- ===================================================== -->
  <!-- 5 m x 5 m Arena Walls                                -->
  <!-- ===================================================== -->

  <!-- North wall -->
  <model name="north_wall">
    <static>true</static>
    <pose>0 2.55 0.25 0 0 0</pose>

    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>5.2 0.1 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>5.2 0.1 0.5</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>


  <!-- South wall -->
  <model name="south_wall">
    <static>true</static>
    <pose>0 -2.55 0.25 0 0 0</pose>

    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>5.2 0.1 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>5.2 0.1 0.5</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>


  <!-- East wall -->
  <model name="east_wall">
    <static>true</static>
    <pose>2.55 0 0.25 0 0 0</pose>

    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 5.2 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.1 5.2 0.5</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>


  <!-- West wall -->
  <model name="west_wall">
    <static>true</static>
    <pose>-2.55 0 0.25 0 0 0</pose>

    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 5.2 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.1 5.2 0.5</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>


   <!-- ===================================================== -->
  <!-- Internal Obstacles - Arena v1                         -->
  <!-- ===================================================== -->

  <!-- ===================================================== -->
  <!-- Obstacle 1: Horizontal obstacle                       -->
  <!-- Position: (-0.8, 0.9)                                -->
  <!-- Size: 0.8 x 0.3 x 0.5 m                              -->
  <!-- ===================================================== -->
  <model name="obstacle_1">
    <static>true</static>

    <!-- x y z roll pitch yaw -->
    <pose>-0.8 0.9 0.25 0 0 0</pose>

    <link name="link">

      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.3 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.8 0.3 0.5</size>
          </box>
        </geometry>
      </visual>

    </link>
  </model>


  <!-- ===================================================== -->
  <!-- Obstacle 2: Vertical obstacle                         -->
  <!-- Position: (1.1, 0.5)                                 -->
  <!-- Size: 0.3 x 1.0 x 0.5 m                              -->
  <!-- ===================================================== -->
  <model name="obstacle_2">
    <static>true</static>

    <!-- x y z roll pitch yaw -->
    <pose>1.1 0.5 0.25 0 0 0</pose>

    <link name="link">

      <collision name="collision">
        <geometry>
          <box>
            <size>0.3 1.0 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.3 1.0 0.5</size>
          </box>
        </geometry>
      </visual>

    </link>
  </model>


  <!-- ===================================================== -->
  <!-- Obstacle 3: Rotated obstacle                          -->
  <!-- Position: (0.8, -1.2)                                -->
  <!-- Size: 0.8 x 0.3 x 0.5 m                              -->
  <!-- Rotation: 30 degrees                                  -->
  <!-- ===================================================== -->
  <model name="obstacle_3">
    <static>true</static>

    <!--
      pose format:
      x y z roll pitch yaw

      30 degrees = pi / 6 ≈ 0.523599 rad
    -->
    <pose>0.8 -1.2 0.25 0 0 0.523599</pose>

    <!-- Visual-only 0.20 m ArUco panel on the local -X face. The panel is
         1 mm outside the original box, with +Z pointing out of that face.
         Its white quiet zone is 0.267 m wide and fits the 0.30 m face. -->
    <include>
      <uri>model://edgeai_aruco_marker</uri>
      <name>aruco_target_1</name>
      <pose>-0.401 0 0 1.570796326795 0 -1.570796326795</pose>
    </include>

    <link name="link">

      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.3 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.8 0.3 0.5</size>
          </box>
        </geometry>
      </visual>

    </link>
  </model>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

  </world>

</sdf>