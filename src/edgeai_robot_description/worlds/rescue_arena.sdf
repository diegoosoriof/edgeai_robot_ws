<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <!-- Challenge coordinates in metres: outer bounds [0,5] x [0,5]. -->
  <world name="rescue_arena">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>
    <!-- Walls are 0.50 m high; boundary walls lie inside the 5 m outer extent. -->
    <model name="south_wall">
      <static>true</static>
      <pose>2.5 0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.1 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static>
      <pose>2.5 4.95 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.1 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>0.05 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.8 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>4.95 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.8 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="W1">
      <static>true</static>
      <pose>1.1 3.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.1 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="W1b">
      <static>true</static>
      <pose>2.2 3.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.5 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="W2">
      <static>true</static>
      <pose>3.4 1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.8 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Obstacle height is assumed 0.50 m, matching the original simulation. -->
    <model name="O2">
      <static>true</static>
      <pose>2.2 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 1.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 1.0 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="O3">
      <static>true</static>
      <pose>4.4 3.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.5</size>
            </box>
          </geometry>
          <cast_shadows>true</cast_shadows>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Floor overlays have no collision geometry and are only 1 mm above the floor. -->
    <model name="start_area">
      <static>true</static>
      <pose>0.7 0.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 1.0 0.001</size>
            </box>
          </geometry>
          <cast_shadows>false</cast_shadows>
          <transparency>0.65</transparency>
          <material>
            <ambient>0.1 0.4 1 1</ambient>
            <diffuse>0.1 0.4 1 1</diffuse>
            <emissive>0.1 0.4 1 1</emissive>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="S1_zone">
      <static>true</static>
      <pose>1.0 4.1 0.001 0 0 0</pose>
      <link name="link">
        <visual name="zone">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <cast_shadows>false</cast_shadows>
          <transparency>0.65</transparency>
          <material>
            <ambient>1 0.1 0.1 1</ambient>
            <diffuse>1 0.1 0.1 1</diffuse>
            <emissive>1 0.1 0.1 1</emissive>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="C1_zone">
      <static>true</static>
      <pose>4.1 1.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="zone">
          <geometry>
            <cylinder>
              <radius>0.7</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <cast_shadows>false</cast_shadows>
          <transparency>0.65</transparency>
          <material>
            <ambient>0.1 0.3 1 1</ambient>
            <diffuse>0.1 0.3 1 1</diffuse>
            <emissive>0.1 0.3 1 1</emissive>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- C1 shows one radius-0.7 m circle as specified; two cooperative zone locations remain undefined. -->
    <!-- S1 faces east toward the opening around W1; C1 faces north. -->
    <include>
      <uri>model://rescue_target_S1</uri>
      <name>S1</name>
      <pose>1.0 4.1 0 0 0 1.570796326795</pose>
    </include>
    <include>
      <uri>model://rescue_target_C1</uri>
      <name>C1</name>
      <pose>4.1 1.0 0 0 0 3.141592653590</pose>
    </include>
  </world>
</sdf>
